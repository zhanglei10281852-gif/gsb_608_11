# ============================================================================
# Qt Log System - 测试专用镜像
# 用法: run_tests.bat (Windows) 或 ./run_tests.sh (Linux/macOS)
# ============================================================================

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# 替换为阿里云镜像源
RUN sed -i 's|http://archive.ubuntu.com|http://mirrors.aliyun.com|g' /etc/apt/sources.list \
    && sed -i 's|http://security.ubuntu.com|http://mirrors.aliyun.com|g' /etc/apt/sources.list

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    qt6-base-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY CMakeLists.txt .
COPY src/ src/
COPY tests/ tests/

RUN cmake -B build -DCMAKE_BUILD_TYPE=Release \
    && cmake --build build --parallel $(nproc)

# 默认运行全部测试（ctest 自动运行 LogHelperTest + LogFormatterTest）
# -v 输出每个用例详情，--output-on-failure 在失败时打印完整输出
ENTRYPOINT ["ctest", "--test-dir", "build", "--output-on-failure", "-v"]
CMD []
